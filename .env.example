# ==============================================================================
# GLOBAL & DOCKER SETTINGS
# ==============================================================================
NODE_ENV=development

# ==============================================================================
# DATABASE (MongoDB)
# ==============================================================================
MONGO_INITDB_ROOT_USERNAME=sanchaya_admin
MONGO_INITDB_ROOT_PASSWORD=sanchaya_secret_pass
MONGO_URI=mongodb://sanchaya_admin:sanchaya_secret_pass@mongo:27017/sanchaya?authSource=admin&retryWrites=true&w=majority
DATABASE_NAME=sanchaya

# ==============================================================================
# BACKEND GATEWAY (Node.js / Express)
# ==============================================================================
PORT=5000
BACKEND_PORT=5000
# REQUIRED — no default exists. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 characters. Never commit the real value to git.
JWT_SECRET=REPLACE_THIS_with_a_32plus_char_random_secret
JWT_EXPIRES_IN=3h
BCRYPT_SALT_ROUNDS=12
# Comma-separated browser origins allowed by CORS (no "*" wildcard in production)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
GITHUB_GLOBAL_PAT=

# ImageKit Document Storage
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# ==============================================================================
# FRONTEND (React / Vite)
# ==============================================================================
FRONTEND_PORT=5173
# Leave empty on Vercel Services (uses same-origin /api rewrite) & Vite dev proxy
VITE_API_URL=

# ==============================================================================
# PYTHON MICROSERVICES (Docker Compose fallback — DO NOT set manually on Vercel; injected via bindings)
# ==============================================================================
AI_SERVICE_URL=http://ai-engine:8001
ANALYTICS_SERVICE_URL=http://analytics-service:8002
# REQUIRED in production (>= 32 chars). Shared X-Internal-Token between backend and Python microservices.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_TOKEN=

# LLM Provider for services/ai-engine ("auto" | "gemini" | "openrouter" | "openai")
LLM_PROVIDER=auto
LLM_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Sanchaya AI Engine
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
FRESHNESS_MAX_AGE_DAYS=90
