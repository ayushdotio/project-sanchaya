# Sanchaya uses a single root .env file (see repo root .env.example).
# Reference values for local standalone runs:
MONGO_URI=mongodb://sanchaya_admin:sanchaya_secret_pass@mongo:27017/sanchaya?authSource=admin
DATABASE_NAME=sanchaya
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENAI_API_KEY=
